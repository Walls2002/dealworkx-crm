# Leave DATABASE_URL empty to use the built-in local Postgres (PGlite, stored in ./.data).
# Set it to any hosted Postgres (Neon, Supabase, Render...) to use that instead.
DATABASE_URL=

# Demo mode: synthetic leads + demo sign-ins on the login page. On by default only for the local database.
DEMO_MODE=

# Required with a real DATABASE_URL (and DEMO_MODE off): the first password for the seeded team accounts.
INITIAL_PASSWORD=

# "Today" for due dates and the dashboard is calculated in this timezone.
APP_TIMEZONE=Asia/Singapore
